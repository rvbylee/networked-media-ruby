<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>scriblit</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <header>
    <div class="menu">
      <a href="/">home</a> /
      <a href="/submit">submit</a> /
      <a href="/archive">archive</a>
    </div>
</nav>
    <h1>
        <img src="/scriblit1.gif" class="logo">
    </h1>
  </header>

  <main>
    <h2>scribble this:</h2>
    <h3><%= wordOfTheDay %></h3>
    <p>
        <a href="/submit" class="submit-icon">
            <img src="/submit.png" class="default-state">
            <img src="/submithover.png" class="hover-state">
        </a>
    </p>

    <div class="gallery">
      <% if (allPosts.length === 0) { %>
        <p class="empty">no scribbles yet. everyone’s pretending not to see the prompt.</p>
      <% } else { %>
        <% allPosts.forEach(p => { %>
          <div class="card">
            <% if (p.image) { %>
              <img src="<%= p.image %>" alt="artwork">
            <% } else { %>
              <div class="no-image">no image provided</div>
            <% } %>
            <p><strong><%= p.artist %></strong></p>
            <p><%= p.caption %></p>
            <small><%= p.date %></small>
          </div>
        <% }) %>
      <% } %>
    </div>
  </main>
</body>
</html>
